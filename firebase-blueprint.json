{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in Jejak Iman",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "customName": { "type": "string", "maxLength": 60 },
        "customAvatar": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "classroomId": { "type": "string", "maxLength": 64 },
        "teamId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName", "email"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "Virtual classroom for student groups",
      "type": "object",
      "properties": {
        "classroomId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 16 },
        "teacherUid": { "type": "string", "maxLength": 128 },
        "teacherEmail": { "type": "string", "maxLength": 150 },
        "maxCapacity": { "type": "number" },
        "studentCount": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["classroomId", "name", "code", "teacherUid"]
    },
    "ClassMember": {
      "title": "ClassMember",
      "description": "Student membership record in a classroom",
      "type": "object",
      "properties": {
        "memberId": { "type": "string", "maxLength": 128 },
        "classroomId": { "type": "string", "maxLength": 64 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "studentEmail": { "type": "string", "maxLength": 150 },
        "studentPhoto": { "type": "string", "maxLength": 500 },
        "customAvatar": { "type": "string", "maxLength": 100 },
        "teamId": { "type": "string", "maxLength": 64 },
        "joinedAt": { "type": "string" }
      },
      "required": ["memberId", "classroomId", "studentUid", "studentName"]
    },
    "EssayDraft": {
      "title": "EssayDraft",
      "description": "Draft response to an essay question",
      "type": "object",
      "properties": {
        "draftId": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "questionId": { "type": "string", "maxLength": 64 },
        "classroomId": { "type": "string", "maxLength": 64 },
        "sessionId": { "type": "string", "maxLength": 64 },
        "answerText": { "type": "string", "maxLength": 10000 },
        "updatedAt": { "type": "string" }
      },
      "required": ["draftId", "studentUid", "questionId", "answerText"]
    },
    "EssaySubmission": {
      "title": "EssaySubmission",
      "description": "Submitted student essay answer for teacher evaluation",
      "type": "object",
      "properties": {
        "submissionId": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "studentPhoto": { "type": "string", "maxLength": 500 },
        "studentEmail": { "type": "string", "maxLength": 150 },
        "classroomId": { "type": "string", "maxLength": 64 },
        "teamId": { "type": "string", "maxLength": 64 },
        "sessionId": { "type": "string", "maxLength": 64 },
        "questionId": { "type": "string", "maxLength": 64 },
        "questionTitle": { "type": "string", "maxLength": 200 },
        "questionTextSnapshot": { "type": "string", "maxLength": 2000 },
        "answerText": { "type": "string", "maxLength": 10000 },
        "submittedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "REVIEWED"] },
        "score": { "type": "number" },
        "teacherFeedback": { "type": "string", "maxLength": 3000 },
        "published": { "type": "boolean" },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["submissionId", "studentUid", "studentName", "questionId", "answerText", "status"]
    },
    "TeacherAuth": {
      "title": "TeacherAuth",
      "description": "Authorized teacher email record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "authorizedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "GameRoom": {
      "title": "GameRoom",
      "description": "Shared real-time classroom multiplayer game session",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "maxLength": 64 },
        "classroomId": { "type": "string", "maxLength": 64 },
        "roomCode": { "type": "string", "maxLength": 16 },
        "title": { "type": "string", "maxLength": 100 },
        "hostTeacherUid": { "type": "string", "maxLength": 128 },
        "hostTeacherEmail": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["lobby", "playing", "paused", "finished"] },
        "gameMode": { "type": "string", "enum": ["individual", "team"] },
        "turnId": { "type": "string", "maxLength": 64 },
        "turnVersion": { "type": "number" },
        "currentTurnIndex": { "type": "number" },
        "activePlayerUid": { "type": "string", "maxLength": 128 },
        "activePlayerName": { "type": "string", "maxLength": 100 },
        "turnState": { "type": "string", "enum": ["WAITING_ROLL", "ROLLING", "MOVING", "ANSWERING_QUESTION", "TURN_COMPLETED", "GAME_OVER"] },
        "diceValue": { "type": "number" },
        "diceRolling": { "type": "boolean" },
        "highlightTile": { "type": "number" },
        "winnerUid": { "type": "string", "maxLength": 128 },
        "winnerName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["roomId", "classroomId", "roomCode", "hostTeacherUid", "status", "turnId", "activePlayerUid"]
    },
    "GameRoomPlayer": {
      "title": "GameRoomPlayer",
      "description": "Connected student or team token in a game room",
      "type": "object",
      "properties": {
        "playerUid": { "type": "string", "maxLength": 128 },
        "playerName": { "type": "string", "maxLength": 100 },
        "characterId": { "type": "string", "maxLength": 64 },
        "customAvatar": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "position": { "type": "number" },
        "stars": { "type": "number" },
        "isTeam": { "type": "boolean" },
        "teamId": { "type": "string", "maxLength": 64 },
        "teamName": { "type": "string", "maxLength": 100 },
        "orderIndex": { "type": "number" },
        "connectionStatus": { "type": "string", "enum": ["online", "answering", "offline"] },
        "deviceId": { "type": "string", "maxLength": 128 },
        "lastSeenAt": { "type": "string" }
      },
      "required": ["playerUid", "playerName", "position", "stars", "connectionStatus"]
    },
    "PrivateQuestion": {
      "title": "PrivateQuestion",
      "description": "Private question assigned exclusively to the active student during their turn",
      "type": "object",
      "properties": {
        "turnId": { "type": "string", "maxLength": 64 },
        "roomId": { "type": "string", "maxLength": 64 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "questionId": { "type": "string", "maxLength": 64 },
        "zone": { "type": "string", "maxLength": 32 },
        "type": { "type": "string", "maxLength": 32 },
        "format": { "type": "string", "maxLength": 32 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "question": { "type": "string", "maxLength": 2000 },
        "explanation": { "type": "string", "maxLength": 2000 },
        "bibleVerse": { "type": "string", "maxLength": 500 },
        "rewardStars": { "type": "number" },
        "status": { "type": "string", "enum": ["ASSIGNED", "ANSWERED"] },
        "submittedAnswer": { "type": "string", "maxLength": 10000 },
        "isCorrect": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "answeredAt": { "type": "string" }
      },
      "required": ["turnId", "roomId", "studentUid", "questionId", "question", "status"]
    },
    "TurnAction": {
      "title": "TurnAction",
      "description": "Idempotent turn action audit log preventing duplicate execution",
      "type": "object",
      "properties": {
        "actionId": { "type": "string", "maxLength": 128 },
        "roomId": { "type": "string", "maxLength": 64 },
        "turnId": { "type": "string", "maxLength": 64 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "actionType": { "type": "string", "enum": ["ROLL_DICE", "SUBMIT_ANSWER", "SKIP_TURN"] },
        "payloadSummary": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["actionId", "roomId", "turnId", "studentUid", "actionType"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles for authenticated students and teachers"
    },
    "/classrooms/{classroomId}": {
      "schema": "Classroom",
      "description": "Classrooms created by teachers"
    },
    "/classrooms/{classroomId}/members/{memberId}": {
      "schema": "ClassMember",
      "description": "Student members in a classroom"
    },
    "/essayDrafts/{draftId}": {
      "schema": "EssayDraft",
      "description": "Student essay draft answers"
    },
    "/essaySubmissions/{submissionId}": {
      "schema": "EssaySubmission",
      "description": "Submitted essay answers for assessment"
    },
    "/teachers/{email}": {
      "schema": "TeacherAuth",
      "description": "Whitelist of teacher Google email addresses"
    },
    "/gameRooms/{roomId}": {
      "schema": "GameRoom",
      "description": "Shared real-time classroom multiplayer game session"
    },
    "/gameRooms/{roomId}/players/{playerUid}": {
      "schema": "GameRoomPlayer",
      "description": "Connected student presence and player record in game room"
    },
    "/gameRooms/{roomId}/privateQuestions/{turnId}": {
      "schema": "PrivateQuestion",
      "description": "Private question assigned exclusively to active student and teacher"
    },
    "/gameRooms/{roomId}/turnActions/{actionId}": {
      "schema": "TurnAction",
      "description": "Idempotency action records"
    }
  }
}
